{
  "name": "@tessera-kit/chat",
  "version": "0.2.0",
  "description": "Chat kit for Tessera: rooms and direct messages with reactions, replies, typing and read receipts, as a headless API and web components. Works across tabs with no backend, or against tessera-server",
  "license": "MIT",
  "author": "Abhishek Thakur",
  "type": "module",
  "sideEffects": [
    "./dist/autoload.js",
    "./dist/elements/**/*.js",
    "./src/autoload.ts",
    "./src/elements/**/*.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./autoload": {
      "types": "./dist/autoload.d.ts",
      "import": "./dist/autoload.js"
    },
    "./elements": {
      "types": "./dist/elements/index.d.ts",
      "import": "./dist/elements/index.js"
    },
    "./elements/*": {
      "types": "./dist/elements/tags/*.d.ts",
      "import": "./dist/elements/tags/*.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@lit/context": "^1.1.0",
    "lit": "^3.3.0",
    "zod": "^4.2.0"
  },
  "peerDependencies": {
    "@tessera-kit/core": "^0.1.0",
    "@tessera-kit/elements": "^0.1.0",
    "@tessera-kit/protocol": "^0.1.0",
    "@tessera-kit/react": "^0.1.0",
    "@tessera-kit/storage": "^0.1.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@tessera-kit/react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@tessera-internal/react-wrap": "workspace:*",
    "@tessera-internal/test-utils": "workspace:*",
    "@tessera-kit/core": "^0.1.0",
    "@tessera-kit/elements": "^0.1.0",
    "@tessera-kit/protocol": "^0.1.0",
    "@tessera-kit/react": "^0.1.0",
    "@tessera-kit/storage": "^0.1.0",
    "@tessera-kit/testing": "^0.1.0",
    "@tessera-kit/transport": "^0.1.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.0.3",
    "playwright": "^1.63.0",
    "react": "^19",
    "react-dom": "^19.3.0"
  }
}
